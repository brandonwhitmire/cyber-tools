{
  "repo": "peass-ng/PEASS-ng",
  "ref": "master",
  "output": "linpeas_oscp.sh",
  "preset": "all-no-fat",
  "no_network_scanning": true,
  "exclude": [
    "cloud",
    "container",
    "api_keys_regex",
    "network_information"
  ],
  "include": [],
  "exclude_notes": {
    "cloud": "AWS/Azure/GCP metadata — hangs waiting on 169.254.169.254",
    "container": "Docker/LXC checks — slow and unused on typical OSCP boxes",
    "api_keys_regex": "Filesystem-wide regex scan — slow, noisy",
    "network_information": "External hostname lookups — hangs on isolated boxes"
  }
}
